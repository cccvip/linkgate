{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "LinkGate",
  "uid": "linkgate-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "活跃连接数",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "linkgate_connections_active",
          "legendFormat": "active connections"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "消息吞吐（msg/s）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(linkgate_messages_delivered_total[1m])",
          "legendFormat": "delivered/s"
        },
        {
          "refId": "B",
          "expr": "rate(linkgate_connections_accepted_total[1m])",
          "legendFormat": "accepted/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ACK 超时（次/s）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(linkgate_ack_timeouts_total[1m])",
          "legendFormat": "ack timeouts/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "连接拒绝（次/s）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(linkgate_connections_rejected_total[1m])",
          "legendFormat": "rejected/s"
        }
      ]
    }
  ]
}
